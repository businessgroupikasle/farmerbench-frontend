# AgriEra Frontend Environment Configuration Template

# Base URL for Backend API
VITE_API_BASE_URL=http://localhost:5000/api

# Base URL for Backend Uploaded Media Assets
VITE_UPLOADS_BASE_URL=http://localhost:5000/uploads


# Public Google OAuth Web Client ID (never put the client secret in frontend env)
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
